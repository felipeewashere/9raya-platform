# Copy this file to .env.local and fill in the values (never commit .env.local).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret: NEVER in the site build. Only for local scripts (content import, e2e test).
# Grading / XP / account deletion run in the Edge Function `api`, which gets it from Supabase.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI).
# Only needed for `npm run db:push` (applying migrations from your computer).
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Public URL of the site, base path included (metadata). Auth links use the page's own origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000/9raya-platform

# Google OAuth Web client ID (public). Enables the Google Identity Services button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
