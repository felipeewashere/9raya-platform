# Copy this file to .env.local and fill in the values (never commit .env.local).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret: server only. Used for grading, XP/streak writes, admin and content import.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI).
# Only needed for `npm run db:push` (applying migrations from your computer).
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Public URL of the site (used in e-mail links). http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
